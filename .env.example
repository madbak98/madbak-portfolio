# Copy to .env.local and fill in. Optional — app has defaults for social URLs.

# Current production origin (www). Apex is not on this Vercel project yet.
# Do not add hostname redirects in middleware or next.config.
# Never set localhost or a Vercel preview URL here.
NEXT_PUBLIC_SITE_URL=https://www.madbak.art

# Google Search Console HTML tag verification token (content value only).
# Vercel → Project → Settings → Environment Variables → Production.
# Leave empty until you have a real token — empty values are omitted from HTML.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional Bing Webmaster Tools verification token.
NEXT_PUBLIC_BING_SITE_VERIFICATION=

NEXT_PUBLIC_EMAIL=

NEXT_PUBLIC_SOCIAL=

NEXT_PUBLIC_SOCIAL_INSTAGRAM=

NEXT_PUBLIC_SOCIAL_X=

NEXT_PUBLIC_SOCIAL_TELEGRAM=

NEXT_PUBLIC_SOCIAL_WHATSAPP=

NEXT_PUBLIC_SOCIAL_LINKEDIN=

NEXT_PUBLIC_SOCIAL_GITHUB=
